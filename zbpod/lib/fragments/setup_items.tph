INCLUDE ~zbpod/lib/kaelyn/zs_cdfunctions.tpa~ // CamDawg's functions that I will use for the items

// Preliminary work, keep at start of file \\

// NB: This can fail to install the mod if the available
// spell states have been exhausted.

LAF ADD_IDS_ENTRY
  STR_VAR
  idsFile = "splstate"
  identifier = "ZB_TWO_HANDED_WEAPON_EQUIPPED"
  RET
  zb_two_handed_weapon_equipped = value
END


