//////// Eshpel \\\\\\\\
INCLUDE ~%MOD_FOLDER%/lib/a7-cutscene_customization.tph~
<<<<<<<< .../inlined/cutscene.baf
IF
THEN
  RESPONSE #100
    CutSceneId(Player1)
    ClearAllActions()
    FadeToColor([30.0],0)
    Wait(2)
    LeaveAreaLUAPanic("zb2010", "", [697.458], SE)
    LeaveAreaLUA("zb2010", "", [697.458], SE)
    ActionOverride(Player2, LeaveAreaLUA("zb2010", "", [766.482], SE))
    ActionOverride(Player3, LeaveAreaLUA("zb2010", "", [592.533], SE))
    ActionOverride(Player4, LeaveAreaLUA("zb2010", "", [653.577], SE))
    ActionOverride(Player5, LeaveAreaLUA("zb2010", "", [701.596], SE))
    ActionOverride(Player6, LeaveAreaLUA("zb2010", "", [744.557], SE))
    Wait(2)
    MultiPlayerSync()
    EndCutSceneMode()
END
>>>>>>>>
LAF EXTEND_CUT250
  STR_VAR baf_file = ".../inlined/cutscene.baf"
  RET guard = value  // can be used later to set the required global variable
END
