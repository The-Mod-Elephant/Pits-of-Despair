// Post production, keep at end of file, do not add new items after this. \\

COPY_EXISTING_REGEXP "^.*\.itm$" "override"
  //READ_SHORT 0x001c item_type
  //READ_BYTE 0x0031 proficiency
  READ_LONG 0x0018 item_flags

  // Add ZB_TWO_HANDED_WEAPON_EQUIPPED spell state to two-handed weapons
  PATCH_IF (item_flags & BIT1)
  BEGIN
    LPF ADD_ITEM_EQEFFECT
      INT_VAR
      opcode		= 328
      target		= 1
      timing		= 2
      parameter2	= zb_two_handed_weapon_equipped
      special		= 1
    END
  END

  BUT_ONLY_IF_IT_CHANGES


